# API & WebSocket Backend URL (When deployed on Vercel)
# Example: https://padly-backend.onrender.com
VITE_BACKEND_URL=

# WebSocket URL (Optional if different)
# Example: wss://padly-backend.onrender.com/ws
VITE_WS_URL=

# TURN / STUN Configuration for Cross-Network Traversal (Mobile Data <-> Wi-Fi)
# Example TURN URL: turn:turn.example.com:3478?transport=udp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional JSON ICE servers configuration:
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
